# Terraform local state (contains resource attributes, often including
# secrets in plaintext - e.g. db_password, connection strings)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Provider plugins/cache (large, machine-specific, not something to
# commit - re-downloaded by `terraform init`)
.terraform/

# Variable files - these typically carry secrets (db_password,
# atlas_project_id, etc.) even though this repo's own terraform.tfvars
# intentionally avoids that (see its own comments) - ignored regardless
# as a safety net for anyone who adds secrets to one locally.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Crash logs can contain sensitive state/variable values
crash.log
crash.*.log

# Local overrides (not meant to be shared/committed)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config (can contain credentials block for private
# registries)
.terraformrc
terraform.rc

# SSH private keys generated by this config (tls_private_key +
# local_sensitive_file) - NEVER commit these
*.pem
*.key

.cache/

# Load-test output (results/<run_id>/ directories with CSVs/logs/JSON
# summaries) - generated locally by run_load_test.sh /
# run_multiregion_load_test.sh, not something to commit
results/

# OS/editor cruft
.DS_Store
*.swp
